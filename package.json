{
  "name": "pi-copy-user-message",
  "version": "1.0.21",
  "description": "pi extension that adds /copy-user to copy the most recent user message to your clipboard",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "clipboard",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-copy-user-message.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-copy-user-message/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-copy-user-message#readme",
  "scripts": {
    "test": "tsx tests/copy-user-message.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck",
    "prepublishOnly": "npm run check && npm pack --dry-run"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.76.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "basic-ftp": "6.0.1"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "packageManager": "npm@11.0.0",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
